# Salin file ini ke .env dan isi nilainya. JANGAN commit .env.

# Lokasi file SQLite (default: radar.db di root proyek)
RADAR_DB_PATH=radar.db

# Lokasi file config kata pantau
RADAR_CONFIG_PATH=config/kata_pantau.yaml

# Path ke JSON service account Google (JANGAN commit file ini ke repo)
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# ID spreadsheet Google Sheet tujuan (bagian di antara /d/ dan /edit pada URL)
# Kosongkan dulu kalau spreadsheet belum ada -- tanyakan ke Denny (lihat Bab 11 brief)
GOOGLE_SHEETS_ID=

# Nama worksheet tujuan (opsional, default sudah sesuai brief)
SHEET_A_NAME=Sheet A
SHEET_KALENDER_NAME=Kalender Rilis
